# ConfTracker configuration. Copy to .env and fill in what you need:
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored and read by every script in scripts/. Everything here is
# optional -- the defaults are the ones the lab machine already runs on -- so
# an empty .env is a valid .env. Uncomment only what you are changing.


# ---- Claude, for deadline extraction -------------------------------------
# Pick ONE. With neither, the pipeline uses the `claude` CLI if it is on PATH
# (that is the current setup on lambda-vector: a subscription login, no key).
#
# CONFTRACKER_BACKEND=api|cli          # force a backend instead of autodetect
# ANTHROPIC_API_KEY=sk-ant-...         # API backend
# CONFTRACKER_MODEL=claude-opus-5      # API backend model
# CONFTRACKER_CLI_MODEL=...            # CLI backend model (default: yours)


# ---- Site ----------------------------------------------------------------
# CONFTRACKER_SITE_URL=https://uiuc-isens.github.io/ConfTracker/


# ---- Outgoing mail -------------------------------------------------------
# Two supported setups. Pick one; do not mix them.
#
# (a) Campus relay, the default. Takes mail from this machine's IP
#     unauthenticated -- no credentials, nothing to renew -- but the sender
#     must stay @illinois.edu or SPF fails at the relay.
#
# CONFTRACKER_REPORT_TO=mt55@illinois.edu       # weekly health report goes here
# CONFTRACKER_REPORT_FROM=mt55@illinois.edu
# CONFTRACKER_SMTP_HOST=outbound-relays.techservices.illinois.edu
# CONFTRACKER_SMTP_PORT=25
#
# (b) Send as the group Gmail. Everything -- reminders and health reports --
#     goes out as the lab address, DKIM-signed by Google, and replies land in
#     the same mailbox the signups are read from. Uses the same app password
#     as IMAP below. Port 587 (STARTTLS); 465 is not supported.
#
#     Gmail sends as the authenticated account, so REPORT_FROM has to be that
#     same address -- set it to anything else and Google silently rewrites it.
#
# CONFTRACKER_REPORT_FROM=smartlab.uiuc@gmail.com
# CONFTRACKER_SMTP_HOST=smtp.gmail.com
# CONFTRACKER_SMTP_PORT=587
# CONFTRACKER_SMTP_USER=smartlab.uiuc@gmail.com
# CONFTRACKER_SMTP_PASSWORD=xxxxxxxxxxxxxxxx    # same app password as IMAP


# ---- Deadline reminders --------------------------------------------------
# Two ways for a signup to arrive. Configure ONE (or both); with neither, the
# feature stays off and the signup buttons never appear on the site.
#
# (1) GitHub issues -- the default. The site's buttons open a prefilled issue;
#     the lab machine reads it with the `gh` CLI it is already logged in to,
#     so there is no new credential and nothing that expires.
#
#     The repo MUST be private. A signup issue contains the subscriber's email
#     address, and on a public repo that is published permanently -- editing
#     it out later does not help, since issue edit history is public too.
#     scripts/preflight.sh refuses a non-private repo.
#
#     Create it once:
#       gh repo create uiuc-iSENS/ConfTracker-signups --private
#       gh label create reminder-signup --repo uiuc-iSENS/ConfTracker-signups
#     then give the lab team Read access so they can open issues.
#
# CONFTRACKER_SIGNUP_REPO=uiuc-iSENS/ConfTracker-signups
# CONFTRACKER_SIGNUP_LABEL=reminder-signup
#
# (2) A mailbox -- the buttons become mailto: links instead. Needs IMAP
#     credentials below. The address is published in docs/data.json (a public
#     repo), so use the lab mailbox, never a personal one.
#
# CONFTRACKER_SUBSCRIBE_ADDRESS=smartlab.uiuc@gmail.com

# The same mailbox, read over IMAP. For Gmail this needs an app password
# (https://myaccount.google.com/apppasswords), not the account password, and
# IMAP enabled in Gmail settings.
#
# CONFTRACKER_IMAP_HOST=imap.gmail.com
# CONFTRACKER_IMAP_PORT=993
# CONFTRACKER_IMAP_USER=smartlab.uiuc@gmail.com
# CONFTRACKER_IMAP_PASSWORD=xxxxxxxxxxxxxxxx

# Who may subscribe. Empty string opens signups to anyone.
# CONFTRACKER_SUBSCRIBE_DOMAINS=illinois.edu

# Where the subscriber list lives. Keep it off the public repo path if you
# move it; the default (private/) is gitignored.
# CONFTRACKER_SUBSCRIBERS=/nas-data/mt55/ConfTracker/private/subscribers.json

# CONFTRACKER_MAX_INBOX=200            # signup mails processed per poll


# ---- Workshop discovery --------------------------------------------------
# Cap on how many linked-but-undated workshops per venue get followed to
# their own site during a --deep run. Raise it for a venue with a very long
# workshop programme; each one costs a fetch and an extraction.
# CONFTRACKER_MAX_TRACK_FOLLOWS=8


# ---- Health report tuning ------------------------------------------------
# CONFTRACKER_STALE_RUNS=5             # runs without data before a venue is flagged
# CONFTRACKER_DIGEST_DAYS=45           # horizon for the upcoming-deadline digest
